@startuml use_case_diagram
' Connect Four Pro v3.0 - Use Case Diyagrami
' Ayrintilar: docs/USE_CASES.md
' Cizim: java -jar plantuml.jar -tpng use_case_diagram.puml  (Graphviz gerekir)

title Connect Four Pro - Use Case Diyagrami (v3.0)

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FDFDFD
  BorderColor #1F3A5F
}

actor "Misafir" as guest
actor "Kayitli Oyuncu" as registered
actor "Oyuncu" as player
actor "Seyirci" as spectator

actor "AI Motoru" as ai <<sistem>>
actor "Zamanlayici" as timer <<sistem>>

player <|-- guest
player <|-- registered

rectangle "Connect Four Pro" {
  package "Hesap" {
    usecase "UC-01 Kayit ol" as UC01
    usecase "UC-02 Giris yap" as UC02
    usecase "UC-03 Misafir olarak devam et" as UC03
    usecase "UC-04 Cikis yap" as UC04
    usecase "UC-15 Mac gecmisi" as UC15
  }

  package "Oyun" {
    usecase "UC-05 Yapay zekaya karsi oyna" as UC05
    usecase "UC-06 Oda olustur" as UC06
    usecase "UC-07 Lobiyi goruntule" as UC07
    usecase "UC-08 Oyuna katil" as UC08
    usecase "UC-09 Online hamle yap" as UC09
    usecase "UC-10 Mac izle" as UC10
    usecase "UC-11 Yeniden baglan" as UC11
    usecase "UC-12 Oyundan ayril (hukmen)" as UC12
    usecase "UC-14 Liderlik tablosu" as UC14
    usecase "UC-16 Hamle analizi" as UC16
  }

  package "Sistem" {
    usecase "Hamle dogrula,\nkazanmayi kontrol et" as VALIDATE
    usecase "UC-13 Oyunu sonuclandir,\nELO guncelle, kaydet" as UC13
    usecase "UC-17 Eski odalari temizle" as UC17
  }
}

guest --> UC01
guest --> UC03
registered --> UC02
registered --> UC04
registered --> UC15

player --> UC05
player --> UC06
player --> UC07
player --> UC08
player --> UC09
player --> UC14
player --> UC16
spectator --> UC10

UC05 ..> VALIDATE : <<include>>
UC09 ..> VALIDATE : <<include>>
UC09 ..> UC13 : <<include>>
UC12 ..> UC13 : <<include>>
UC10 ..> UC08 : <<extend>>
UC11 ..> UC09 : <<extend>>
UC12 ..> UC09 : <<extend>>

UC05 <-- ai
UC16 <-- ai
UC11 <-- timer
UC17 <-- timer

note "Kolay D2 / Orta D4 / Zor D6\nMinimax + Alpha-Beta, bitboard" as N1
N1 .. UC05
note "Zamanlayici: oyuncu 30 sn icinde\ndonmezse rakip hukmen kazanir" as N2
N2 .. UC11
note "ELO sadece iki kayitli oyuncu arasinda\ndegisir (K=30, en az 10 puan)" as N3
N3 .. UC13
@enduml
