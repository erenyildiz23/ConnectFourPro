<Project Sdk="Microsoft.NET.Sdk">
  <!-- unity/Assets/Scripts/Core asmdef'inin karsiligi: Unity'deki assembly sinirlari
       (internal erisim, referanslar) burada da ayni olsun diye ayri derlenir. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ConnectFourPro.Core</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../unity/Assets/Scripts/Core/**/*.cs" LinkBase="Core" />
    
  </ItemGroup>
</Project>
