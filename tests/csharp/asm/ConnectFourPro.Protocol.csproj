<Project Sdk="Microsoft.NET.Sdk">
  <!-- unity/Assets/Scripts/Protocol asmdef'inin karsiligi: Unity'deki assembly sinirlari
       (internal erisim, referanslar) burada da ayni olsun diye ayri derlenir. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ConnectFourPro.Protocol</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../unity/Assets/Scripts/Net/Protocol/**/*.cs" LinkBase="Protocol" />
    <ProjectReference Include="ConnectFourPro.Core.csproj" />
  </ItemGroup>
</Project>
