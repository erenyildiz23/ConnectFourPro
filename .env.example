# Connect Four Pro - ornek ortam degiskenleri
# Bu dosyayi kopyalayip degerleri kendinize gore doldurun; gercek sifreleri git'e eklemeyin.

# Sunucu
DATABASE_URL=postgresql://postgres:SIFRENIZ@localhost/connect4
SECRET_KEY=uzun-rastgele-bir-deger
CONNECT4_HOST=0.0.0.0
CONNECT4_PORT=5000
RECONNECT_GRACE_SECONDS=30
DB_POOL_SIZE=20
LOG_LEVEL=INFO

# Istemci (uzak sunucu / ngrok)
CONNECT4_SERVER=http://localhost:5000

# Testler (pytest) icin ayri bir veritabani kullanin; testler bu veritabanini temizler
TEST_DATABASE_URL=postgresql://postgres:SIFRENIZ@localhost/connect4_test
